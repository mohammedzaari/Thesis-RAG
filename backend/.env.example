NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:4200
MONGO_URI=mongodb://localhost:27017/thesis_rag
JWT_SECRET=change_me_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_too_with_openssl_rand_hex_32
# Optional: restrict self-registration to an institutional domain (e.g. univ.ma)
ALLOWED_EMAIL_DOMAIN=
# First administrator, created at startup when SEED_ON_START=true
SEED_ON_START=true
ADMIN_EMAIL=<mail>
ADMIN_PASSWORD=<password>
# LLM (optional: without a key the assistant returns extractive answers)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Embeddings (optional: without a key retrieval uses MongoDB full-text search)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
UPLOAD_DIR=public/uploads
